#!/usr/bin/env python3
"""Acceptance evidence for a passing unit in one command: two Boat compile hosts, three compare hosts.

    tools/verifier/confirm <task-dir> [--replace] [--out DIR]          # session mode (default)
    tools/verifier/confirm --session <task-dir>... | --list FILE [--replace] [--out DIR]   # batch (--all is the same)
    tools/verifier/confirm --fork <task-dir> [--replace] [--stop]      # old per-unit fork
    tools/verifier/confirm --boat ...                                  # Boat session even with runners set

When .local/verifier/runners.json lists `confirm` hosts, confirm runs on them instead of Boat
(confirm_runners.py: the maintainer's Mac under Wine and Windows PC natively; every unit compiled
on each, compared on each and cross-compared on this Mac; docs/verification.md, "Runner hosts").
--boat keeps the Boat session path. On runner hosts each unit's lines are logged as it finishes
(also to .local/verifier/confirm-logs/), and --resume skips units an earlier run completed for
the same inputs and freshly measured toolchains (tools/verifier/README.md).

Session mode (confirm_session.py) needs a verifier session (tools/verifier/session up): it
compiles on machines A and B, compares on A, B and this Mac, starts no machine, and labels the
records `independence: separate-machine`. --all or --list (one task directory per line) confirm
many units in one run with one summary table. --out writes records under DIR/<build id>/ instead
of reports/. The rest of this text describes the --fork path, which costs one start per unit.

Runs on the checkout's working tree. A record binds the unit's tu-sha256-v1 digest and the recipe
and symbol-map hashes, never a commit, so a unit may be confirmed before it is committed: that is
how a change to an accepted unit, its re-confirmation and its re-review land in one commit. The
record's notes say honestly which state it came from (base commit, and the files that were
uncommitted). Every function in task.json must already be an inventory entry and the symbol map
must be the repository's (`reports/<build id>/...`).

1. Forks the standing verifier (`sr-<task-id>-confirm`, no account secrets, monitoring off). A
   stopped standing machine is forked as it is, then resumed. A running one is forked while
   running: its snapshot may be up to a minute old, which is harmless here because every input
   is uploaded fresh and checked by hash on the fork, and the fork checks the toolchain against
   pinned.sha256 and the image against builds/target.json itself.
2. On both machines, in parallel, from an empty task directory: compile once with the recipe and
   compare every function (tools/verifier/unit_build.py, same checks as `attempt`).
3. Compares both objects again on this Mac against the local image.
4. Writes reports/<build id>/0x<rva>.json for each function with tools/verifier/match_record.py
   (four runs: two compile hosts, three compare hosts), then runs tools/check.py.
5. Removes the task files from both machines and deletes the fork, also on failure. The standing
   machine keeps running until its deadline unless --stop is given.

An existing record is replaced only with --replace. Writing a record is not acceptance; the
Reviewer and tools/accept_function.py steps of docs/verification.md follow.
"""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import threading
import time

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import boatctl  # noqa: E402
import pipeline  # noqa: E402
import check  # noqa: E402  (pipeline puts tools/ on the path)
from pipeline import REPO, PipelineError  # noqa: E402
from runners import RunnerError  # noqa: E402

STANDING_LABEL = 'boat-standing-verifier'
FORK_LABEL = 'boat-fork-of-standing-verifier'
MAC_LABEL = 'macos-arm64-local'
FORK_TTL = 1800
SHORT = {STANDING_LABEL: 'standing', FORK_LABEL: 'fork', f'{MAC_LABEL}<-{STANDING_LABEL}': 'mac(standing-obj)',
         f'{MAC_LABEL}<-{FORK_LABEL}': 'mac(fork-obj)'}


def notes(task, recipe):
    return [
        'Comparator reports are embedded verbatim. Their acceptance field is the comparator\'s own and stays '
        'not-evaluated. Acceptance follows the acceptance rule in docs/verification.md: this record, a sanitized '
        'Reviewer approve bound to the same source digest, and integration by tools/accept_function.py.',
        'independence: fork. The fork is a copy of the standing verifier machine\'s disk, so it shares that '
        'toolchain install and Ubuntu image; each Boat host checked its compiler binaries against pinned.sha256 '
        'and its image against builds/target.json before compiling. The macOS host only compared; it did not compile.',
        'Build environment on both compile hosts: INCLUDE, LIB, LIBPATH, CL, _CL_ and EXTERNAL_INCLUDE removed '
        'before the compile, INCLUDE then set by the msvc-wine wrapper to toolchain and SDK directories only; '
        '/showIncludes added after the recipe flags, and the repository files the compiler opened equalled the '
        'include closure. Each host\'s flags, cleared variables, object hash and opened files are in the build '
        'block, as that host reported them; the gate checks that block for presence and consistency with the runs, '
        'not for truth.',
        '/showIncludes was measured once, on the first accepted unit, to change no object section except the '
        'object-path record in .debug$S (and the .chks64 checksum of it); it was not re-measured for this unit.',
        'Whole-object hashes differ between compiles in the COFF timestamp, the object path recorded in .debug$S '
        '(each host compiles to its own path) and the .chks64 checksum of that section.',
        'A byte match shows that this source and recipe produce the checked code. It does not verify the '
        'community name, and it does not show that the original source looked like this.',
    ] + task['record_notes']


def reproduction(task, fn, closure, recipe):
    """The commands the compile hosts ran, in the order and with the environment they used."""
    flags = ' '.join(recipe['flags'] + check.BUILD_ADDED_FLAGS)
    unset = ' '.join(f'-u {name}' for name in check.BUILD_CLEARED_ENV)
    unit = ' '.join(closure)
    return (f'From the repository root, with cl {recipe["compiler"]["version"].split(" ")[0]} x64 under msvc-wine whose '
            f'binaries match tools/verifier/pinned.sha256 (tools/verifier/setup_boat_machine.sh installs it at <msvc>): '
            f'env {unset} <msvc>/bin/x64/cl {flags} /Fo<work>/candidate.obj {task["compiled"]} '
            f'(the wrapper then sets INCLUDE to toolchain and SDK directories only; the verifier required the '
            f'repository files /showIncludes lists to equal --unit below) ; ' + compare_steps(task, fn, unit))


def compare_steps(task, fn, unit):
    """The steps after the compile: task file from the object, then the comparator."""
    return (f'python3 -I tools/verifier/tu_task.py --function-id {task["build_id"]}-0x{fn["rva"]:x} '
            f"--symbol '{fn['symbol']}' --compiled {task['compiled']} --unit {unit} --recipe {task['recipe']} "
            f'--symbols {task["symbols_repo"]} --object <work>/candidate.obj --out <work> ; '
            f'python3 tools/verifier/verify_function.py --task-file <work>/task-file.json --object '
            f'<work>/candidate.obj --build-record <work>/build-record.json --image <your SkyrimSE.exe> '
            f'--report <work>/report.json')


def build_block(task, host_dirs):
    """The record's `build` block from each compile host's compile command and build record."""
    hosts = {}
    for label, host_dir in host_dirs.items():
        cmd = json.loads((host_dir / 'compile-command.json').read_text())
        out = [i for i, arg in enumerate(cmd) if arg.startswith('/Fo')]
        if len(out) != 1 or cmd[out[0] + 1:] != [task['compiled']]:
            raise PipelineError(f'{label}: compile command does not end in /Fo<object> {task["compiled"]}')
        records = [json.loads((host_dir / f'0x{fn["rva"]:x}' / 'build-record.json').read_text())
                   for fn in task['functions']]
        env = records[0].get('environment') or {}
        if any(r != records[0] for r in records):
            raise PipelineError(f'{label}: build records of one compile differ')
        if sorted(env.get('cleared') or []) != check.BUILD_CLEARED_ENV or env.get('added_flags') != check.BUILD_ADDED_FLAGS:
            raise PipelineError(f'{label}: build record environment is not the verifier\'s')
        shown = env.get('show_includes') or {}
        hosts[label] = {'command_flags': cmd[:out[0]], 'object_sha256': records[0]['object_sha256'],
                        'repository_files_opened': shown.get('repository_files'),
                        'opened_equals_closure': shown.get('equals_closure')}
    return {'claim': 'Build facts are self-reported by each compile host (tools/verifier/unit_build.py build '
                     'record). tools/check.py verifies only that they are present and consistent with the runs '
                     'and the translation unit.',
            'added_flags': list(check.BUILD_ADDED_FLAGS), 'cleared_environment': list(check.BUILD_CLEARED_ENV),
            'hosts': hosts}


# Verifier-side inputs whose content can change a result: the comparator and parser, the host build
# and compare scripts, and this pipeline with the record assembly and the validator it calls.
RESULT_TOOLS = list(pipeline.TOOL_FILES) + ['tools/verifier/confirm', 'tools/verifier/pipeline.py',
                                            'tools/verifier/match_record.py', 'tools/check.py']


def source_state(task, closure):
    """Where the inputs came from, for the record's notes: base commit and every uncommitted input."""
    head = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True)
    if head.returncode != 0:
        raise PipelineError('git rev-parse failed; run from a git checkout')
    return (head.stdout.strip(), pipeline.git_dirty(closure + [task['recipe'], task['symbols_repo']] + RESULT_TOOLS),
            check.comparator_source_sha256())


def source_note(base, dirty, comparator):
    bound = (f'The runs bind the unit digest, recipe and symbol-map hashes above and comparator source '
             f'sha256 {comparator} (each report\'s comparator.source_sha256), not a commit')
    if not dirty:
        return f'Source state: committed tree at base commit {base}. {bound}; that commit holds all of them.'
    return (f'Source state: working tree on base commit {base}, with uncommitted changes to {", ".join(dirty)} at '
            f'confirm time. {bound}; tools/check.py recomputes them from whatever tree this record is committed in.')


def preflight(task, closure, replace):
    if task['symbols_repo'] is None:
        raise PipelineError('confirm needs the repository symbol map (task.json "symbols": "reports/<build id>/...")')
    progress = json.loads((REPO / 'data/progress.json').read_text())
    entries = {f['id']: f for f in progress['functions']}
    for fn in task['functions']:
        fid = f'{task["build_id"]}-0x{fn["rva"]:x}'
        entry = entries.get(fid)
        if entry is None or entry['rva'] != fn['rva'] or entry['size'] != fn['size']:
            raise PipelineError(f'{fid} with size {fn["size"]} is not an inventory entry; add it before confirming')
        out = REPO / 'reports' / task['build_id'] / f'0x{fn["rva"]:x}.json'
        if out.exists() and not replace:
            raise PipelineError(f'{out.relative_to(REPO)} exists; pass --replace to rewrite it from new runs')


def mac_compare(task, fn, host_dir, dest):
    """Compare a Boat host's object on this Mac with this checkout's comparator and the local image."""
    config = pipeline.load_config(task['dir'])
    image = config.get('image')
    if not image or not Path(image).is_file():
        raise PipelineError('no local image configured (.local/verifier/config.json "image")')
    fdir = host_dir / f'0x{fn["rva"]:x}'
    remote_task = json.loads((fdir / 'task-file.json').read_text())['task']
    if dest.exists():
        shutil.rmtree(dest)
    dest.mkdir(parents=True, exist_ok=True)
    task_file = {'verify_task_schema': 1, 'task': remote_task,
                 'recipe': os.path.relpath(REPO / task['recipe'], dest),
                 'symbols': os.path.relpath(REPO / task['symbols_repo'], dest),
                 'manifest': os.path.relpath(REPO / 'builds/target.json', dest)}
    (dest / 'task-file.json').write_text(json.dumps(task_file, indent=2) + '\n')
    diagnostics = REPO / '.local/verifier/diagnostics' / f'confirm-{task["task_id"]}-{host_dir.name}-0x{fn["rva"]:x}.json'
    proc = subprocess.run([sys.executable, str(REPO / 'tools/verifier/verify_function.py'),
                           '--task-file', str(dest / 'task-file.json'), '--object', str(host_dir / 'candidate.obj'),
                           '--build-record', str(fdir / 'build-record.json'), '--image', image,
                           '--report', str(dest / 'report.json'), '--diagnostics', str(diagnostics)],
                          capture_output=True, text=True)
    (dest / 'summary.txt').write_text(proc.stdout + proc.stderr)
    return proc.returncode, dest / 'report.json'


def result_of(report_path):
    try:
        r = json.loads(Path(report_path).read_text())
        return r.get('result'), r.get('reason')
    except (OSError, ValueError):
        return 'error', 'no-report'


def confirm(task_dir, replace, stop_after):
    started = time.monotonic()
    task = pipeline.load_task(task_dir)
    handle = pipeline.lock(task['dir'])  # noqa: F841 (held until exit)
    files, closure = pipeline.unit_manifest(task)
    preflight(task, closure, replace)
    # Taken before uploading, so the note describes the files the hosts compiled.
    tree_state = source_state(task, closure)
    recipe = json.loads((REPO / task['recipe']).read_text())
    config = pipeline.load_config(task['dir'])
    out_root = task['dir'] / 'confirm'
    stage = task['dir'] / '.confirm-stage'
    remote_dir = f'{boatctl.REMOTE_HOME}/tasks/{task["task_id"]}-confirm'
    before = boatctl.compute_used()
    lines = []
    failed = True

    standing, state = boatctl.lookup()
    if standing is None:
        raise PipelineError(f'no machine named {boatctl.STANDING}')
    others = [s for s in json.loads(boatctl.cli('list', '--all', '--json').stdout)['sandboxes']
              if s['state'] in boatctl.RUNNING and s['id'] != standing]
    if others:
        raise PipelineError('another extra machine is running (' + ', '.join(s['id'] for s in others)
                            + '); at most one extra machine at a time')
    if state == 'stopping':
        state = pipeline.wait_state(standing, {'stopped'})
    fork_name = f'sr-{task["task_id"]}-confirm'
    fork = None
    hosts = {}
    try:
        t0 = time.monotonic()
        fork = boatctl.fork(standing, fork_name, FORK_TTL)
        fork_seconds = time.monotonic() - t0
        how = 'forked while stopped' if state == 'stopped' else 'forked while running'
        if state not in boatctl.RUNNING:
            pipeline.ensure_standing()
        hosts = {STANDING_LABEL: pipeline.Host(standing, STANDING_LABEL, remote_dir, task,
                                               local_image=config.get('image')),
                 FORK_LABEL: pipeline.Host(fork, FORK_LABEL, remote_dir, task, local_image=config.get('image'))}
        outcome = {}

        def work(label, host):
            try:
                code, _ = host.run(files, stage / label, fresh=True)
                outcome[label] = (code, host.fetch(out_root / label))
            except Exception as exc:  # reported below; the fork is deleted either way
                outcome[label] = (None, exc)

        threads = [threading.Thread(target=work, args=item) for item in hosts.items()]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        for label, (code, value) in outcome.items():
            if code is None:
                raise PipelineError(f'{label}: {value}')
            if code not in (0, 1):
                raise PipelineError(f'{label}: the unit did not build or was refused (exit {code}); '
                                    f'run tools/verifier/attempt first, details in {value}')
        runs = {fn['rva']: [] for fn in task['functions']}
        table = {fn['rva']: {} for fn in task['functions']}
        for label in (STANDING_LABEL, FORK_LABEL):
            host_dir = outcome[label][1]
            for fn in task['functions']:
                remote_report = host_dir / f'0x{fn["rva"]:x}' / 'report.json'
                table[fn['rva']][label] = result_of(remote_report)
                runs[fn['rva']].append((label, label, remote_report))
                _, mac_report = mac_compare(task, fn, host_dir, out_root / 'mac' / label / f'0x{fn["rva"]:x}')
                table[fn['rva']][f'{MAC_LABEL}<-{label}'] = result_of(mac_report)
                runs[fn['rva']].append((label, MAC_LABEL, mac_report))
        lines.append(f'confirm {task["task_id"]}: fork {how} ({fork_seconds:.0f} s), '
                     f'compiled on 2 Boat hosts, compared on 3 hosts')
        failed = False
        for fn in task['functions']:
            row = table[fn['rva']]
            ok = all(v[0] == 'pass' for v in row.values())
            failed |= not ok
            shown = ' '.join(f'{SHORT[k]}={v[0]}' + ('' if v[0] == 'pass' else f':{v[1]}') for k, v in row.items())
            lines.append(f'  0x{fn["rva"]:x} {"REPRODUCED" if ok else "NOT REPRODUCED"}  {shown}')
        if failed:
            lines.append('  no record written: every run must pass; a pass that fails to reproduce is escalated')
        else:
            build_path = task['dir'] / 'confirm' / 'build.json'
            build_path.write_text(json.dumps(build_block(task, {label: outcome[label][1] for label in hosts}),
                                             indent=2) + '\n')
            for fn in task['functions']:
                fid = f'{task["build_id"]}-0x{fn["rva"]:x}'
                out = f'reports/{task["build_id"]}/0x{fn["rva"]:x}.json'
                cmd = [sys.executable, str(HERE / 'match_record.py'), '--function-id', fid, '--unit', *closure,
                       '--compiled', task['compiled'], '--recipe', task['recipe'], '--symbols', task['symbols_repo'],
                       '--reproduction', reproduction(task, fn, closure, recipe), '--build', str(build_path),
                       '--out', out]
                for compiled_on, compared_on, report in runs[fn['rva']]:
                    cmd += ['--run', compiled_on, compared_on, str(report)]
                for note in notes(task, recipe) + [source_note(*tree_state)]:
                    cmd += ['--note', note]
                proc = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True)
                lines.append(f'  record {out}: ' + ('written' if proc.returncode == 0
                                                     else 'REFUSED ' + (proc.stderr or proc.stdout).strip()[-200:]))
                failed |= proc.returncode != 0
            check = subprocess.run([sys.executable, str(REPO / 'tools/check.py')], cwd=REPO, capture_output=True, text=True)
            lines.append('  check.py: ' + (check.stdout or check.stderr).strip().splitlines()[-1][:160])
            failed |= check.returncode != 0
    finally:
        for label, host in hosts.items():
            try:
                boatctl.execute(host.machine, f'rm -rf {shlex.quote(remote_dir)}', 60)
            except boatctl.BoatError:
                lines.append(f'  warning: could not remove {remote_dir} on {label}')
        if fork is not None:
            fork_usage = None
            try:
                boatctl.stop(fork)
                pipeline.wait_state(fork, {'stopped'}, 300)
                fork_usage = boatctl.usage_seconds(fork)
            finally:
                boatctl.delete(fork)
            lines.append(f'  fork {fork_name} deleted after {fork_usage} s billed')
        if stop_after:
            boatctl.stop(standing)
            pipeline.wait_state(standing, {'stopped'}, 300)
            lines.append(f'  {boatctl.STANDING} stopped')
        else:
            lines.append(f'  {boatctl.STANDING} left running until its deadline (tools/verifier/attempt --stop)')
        after = boatctl.compute_used()
        used = [after.get('trialComputeUsedSeconds'), before.get('trialComputeUsedSeconds')]
        if None not in used:
            pipeline.record_cost(task, 'confirm', used[0] - used[1], time.monotonic() - started)
        lines.append(f'  private: {out_root}/  time {time.monotonic() - started:.0f} s; compute '
                     f'{before["trialComputeUsedSeconds"]} -> {after["trialComputeUsedSeconds"]} s (counter may lag)')
        print('\n'.join(lines))
    return 1 if failed else 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('task_dirs', nargs='*')
    p.add_argument('--replace', action='store_true', help='rewrite existing match records from the new runs')
    p.add_argument('--stop', action='store_true', help='with --fork: stop the standing machine at the end')
    p.add_argument('--fork', action='store_true', help='old path: fork the standing machine for this unit')
    p.add_argument('--all', '--session', dest='all', action='store_true',
                   help='session mode, several units: every task directory given, first pass on A, second on B')
    p.add_argument('--list', type=Path, help='session mode: file with one task directory per line')
    p.add_argument('--out', type=Path, help='session mode: write records under OUT/<build id>/, not reports/')
    p.add_argument('--boat', action='store_true', help='use the Boat session even when runner confirm hosts are set')
    p.add_argument('--resume', action='store_true',
                   help='runner hosts: skip units whose records an earlier run wrote for the same inputs and toolchains '
                        '(journal under .local/verifier/confirm-journal/)')
    a = p.parse_args()
    dirs = list(a.task_dirs)
    if a.list:
        dirs += [x.strip() for x in a.list.read_text().splitlines() if x.strip() and not x.startswith('#')]
    if not dirs:
        p.error('a task directory is required')
    try:
        import bind
        bind.preflight(dirs)
        if a.fork:
            if len(dirs) != 1 or a.out or a.resume:
                p.error('--fork confirms one unit and writes to reports/ (no --out, no --resume)')
            return confirm(dirs[0], a.replace, a.stop)
        if len(dirs) > 1 and not (a.all or a.list):
            p.error('several task directories need --all')
        if a.stop:
            p.error('--stop is for --fork; a session ends with tools/verifier/session down')
        import runners
        hosts = None if a.boat else runners.for_confirm()
        if hosts:
            import confirm_runners
            return confirm_runners.run(sys.modules[__name__], dirs, a.replace, a.out.resolve() if a.out else None,
                                       hosts=hosts, resume=a.resume)
        if a.resume:
            p.error('--resume is for runner hosts')
        import confirm_session
        return confirm_session.run(sys.modules[__name__], dirs, a.replace,
                                   a.out.resolve() if a.out else None)
    except (PipelineError, boatctl.BoatError, RunnerError, ValueError) as exc:
        print(f'confirm: {exc}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
