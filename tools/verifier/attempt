#!/usr/bin/env python3
"""One reconstruction attempt: compile the unit on the standing verifier and compare each function.

    tools/verifier/attempt <task-dir>            # .local/tasks/<task-id>/ with task.json
    tools/verifier/attempt --clean <task-dir>    # remove this task's files on the machine (never stops it)
    tools/verifier/attempt <group-dir>           # a multi-unit task (group.json): print each unit's state

A multi-unit ("small") task is a directory with group.json and one ordinary task directory per
unit below it; each unit is attempted, budgeted and reported on its own.

Run from the checkout whose reconstruction/ sources you are trying. Where it runs is chosen by
.local/verifier/runners.json (tools/verifier/runners.py): its `attempt` host may be this Mac
(`local`, the pinned compiler under Wine) or an `ssh` host; such a run waits for one of the host's
`max_parallel` slots, so concurrent Drafters queue instead of colliding. Without that config, or
with `"attempt": "boat"`, the Boat path below applies unchanged. When a verifier session is
up (tools/verifier/session) it uses machine A and never starts or stops a machine; without a
session it resumes the standing machine if needed (or extends its auto-stop deadline). It uploads only files that changed
since the last attempt, compiles with the task's recipe, compares every listed function against
the pinned image kept on the machine, and fetches private diagnostics to
<task-dir>/attempts/<NNN>/. After every successful compile it binds the names from the compiled
object (tools/verifier/bind.py, hints in <task-dir>/bind-hints.json, the destructor kind from the
pack); when that changes a binding (`unbound:` symbols, a renamed declaration, a new callee, a new
hint, a plain destructor bound where the target is a deleting one) it compares again in the same
invocation. A hint at a compared function's RVA that ends up unused is printed as a WARNING. A run in which nothing
could be compared because of binding does not count against max_attempts, nor do the first three
compile failures of a unit (later ones count). A repository include the compiler would not find
with the recipe's include roots is refused locally before any upload, uncounted; so is a unit
whose .cpp does not exist yet (exit 2), with the tools/skeleton.py command that writes starting
files. It prints one line per function with the reason code, first mismatch offset and
candidate/target sizes, what was bound or is still missing, and where to read the side-by-side
disassembly, then the findings of tools/check_labels.py on the unit's sources as warnings and the
bodies tools/check_origin.py finds close to a same-named community or FNV body. The
machine stops itself at its deadline; an Engineer ends a session with `tools/verifier/session
down` (attempt never stops a machine; --stop is retired).

Exit status: 0 every function passed, 1 a function failed, 3 compile failed, 4 unit or include
problem, 5 budget exhausted, 2 anything else. A pass is evidence for review only; it makes
nothing `matched`.
"""
import argparse
import json
from pathlib import Path
import shlex
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import align  # noqa: E402
import bind  # noqa: E402
import boatctl  # noqa: E402
import disasm  # noqa: E402
import pipeline  # noqa: E402
from pipeline import PipelineError  # noqa: E402
import runners  # noqa: E402

LABEL = 'standing'


# A compile error is usually a typo or an include the Drafter can fix without learning anything
# about the target, so the first few per unit are free; the cap keeps a unit that never compiles
# from looping on the machine forever.
FREE_COMPILE_FAILURES = 3


def log_rows(log):
    if not log.is_file():
        return []
    return [json.loads(line) for line in log.read_text().splitlines() if line.strip()]


def counted_attempts(log):
    """Attempts that count against max_attempts: every logged run except binding-only ones and
    the free compile failures."""
    return sum(1 for r in log_rows(log) if r.get('counted', True))


def charge(code, binding_only, log):
    """(counted, free_compile_failure) for a finished run: binding-only runs never count, and a
    compile failure (exit 3) is free while fewer than FREE_COMPILE_FAILURES were free before."""
    if binding_only:
        return False, False
    if code == 3 and sum(1 for r in log_rows(log) if r.get('free_compile_failure')) < FREE_COMPILE_FAILURES:
        return False, True
    return True, False


def missing_source_message(task, repo=None):
    """Plain words and the next step when the unit's .cpp does not exist yet (the case the include
    scan reports as "not a repository-relative regular file"); None otherwise, so every other
    path through attempt is unchanged. Nothing has been compiled or counted at that point."""
    repo = Path(repo or pipeline.REPO)
    cpp = task['compiled']
    if (repo / cpp).exists():
        return None
    header = cpp[:-len('.cpp')] + '.h'
    tdir = Path(task['dir'])
    shown = tdir.relative_to(repo) if tdir.is_relative_to(repo) else tdir
    also = '' if (repo / header).exists() else f' (nor does {header})'
    return (f'{cpp} does not exist yet{also}, so there is nothing to compile; this run was not counted. '
            f'Create {cpp} and {header} first. To get starting files with every header line, the labels and '
            f'one stub per function, run: python3 tools/skeleton.py {shown}')


def results_of(task, dest):
    out = {}
    for fn in task['functions']:
        try:
            report = json.loads((dest / f'0x{fn["rva"]:x}' / 'report.json').read_text())
        except (OSError, ValueError):
            report = {}
        out[fn['rva']] = report.get('reason')
    return out


def run_once(task, host, files, task_dir, dest):
    code, out = host.run(files, task_dir / '.attempt')
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        host.fetch(dest)
    except (boatctl.BoatError, runners.RunnerError):
        dest.mkdir(parents=True, exist_ok=True)
    (dest / 'remote.txt').write_text(out)
    return code


def attempt(task_dir):
    started = time.monotonic()
    task = pipeline.load_task(task_dir)
    task_dir = task['dir']
    handle = pipeline.lock(task_dir)  # noqa: F841 (held until exit)
    attempts = task_dir / 'attempts'
    done = sorted(p for p in attempts.glob('[0-9][0-9][0-9]') if p.is_dir()) if attempts.is_dir() else []
    number = int(done[-1].name) + 1 if done else 1
    budget = task['max_attempts']
    used = counted_attempts(task_dir / 'attempts.jsonl')
    if budget is not None and used >= budget:
        print(f'attempt budget exhausted: {budget} of {budget} used. Write your result lines and stop.')
        return 5
    missing = missing_source_message(task)
    if missing:
        # Same exit and stream as the include-closure error this replaces; only the words differ.
        print(f'attempt: {missing}', file=sys.stderr)
        return 2
    files, closure = pipeline.unit_manifest(task)
    problem = pipeline.compiler_include_problem(task)
    if problem:
        # Refused before any upload or log entry, so it neither uses the machine nor counts.
        print(f'attempt {number} {task["task_id"]}: REFUSED include (not counted)\n    {problem}')
        return 4
    config = pipeline.load_config(task_dir)
    runner = runners.for_attempt()
    if runner is None:
        machine, how = pipeline.ensure_standing()
        host = pipeline.Host(machine, LABEL, f'{boatctl.REMOTE_HOME}/tasks/{task["task_id"]}', task,
                             state_path=task_dir / '.attempt' / 'sync.json', local_image=config.get('image'))
        where = f'machine: {boatctl.STANDING} {how}; it stops itself at its deadline'
    else:
        host = runners.AgentHost(runner, task, log=lambda m: print(m, file=sys.stderr))
    dest = attempts / f'{number:03d}'
    code = run_once(task, host, files, task_dir, dest)
    bind_lines = []
    # Binding runs on every compile, not only when a reason code says a name is missing: a function
    # bound to the wrong one of several definitions (a plain destructor for a deleting one) fails
    # with a code difference, and a hint added afterwards would otherwise never be read.
    if code in (0, 1) and not (dest / 'error.json').is_file() and (dest / 'candidate.obj').is_file():
        try:
            report = bind.bind(task_dir, dest / 'candidate.obj', config.get('image'), config.get('objdump'))
        except (OSError, ValueError) as exc:
            report = None
            bind_lines.append(f'  binding failed: {exc}')
        if report is not None:
            bind_lines += bind.describe(report, task_dir)
            if report['changed']:
                # Same source, new names: compile and compare again so this invocation reports real results.
                task = pipeline.load_task(task_dir)
                files, closure = pipeline.unit_manifest(task)
                host.task = task
                code = run_once(task, host, files, task_dir, dest)
                bind_lines.append('  re-compared after binding (same source)')
    results = results_of(task, dest)
    binding_only = code in (0, 1) and bool(results) and all(r in bind.BINDING_REASONS for r in results.values())
    counted, free_compile = charge(code, binding_only, task_dir / 'attempts.jsonl')
    lines, all_rows = [], []
    shown = used + (1 if counted else 0)
    why_free = ''
    if binding_only:
        why_free = ' (binding only, not counted)'
    elif free_compile:
        n = sum(1 for r in log_rows(task_dir / 'attempts.jsonl') if r.get('free_compile_failure')) + 1
        why_free = f' (compile failure {n}/{FREE_COMPILE_FAILURES} free, not counted)'
    head = (f'attempt {number} {task["task_id"]} ({task["compiled"]}); counted {shown}'
            + (f'/{budget}' if budget else '') + why_free)
    error = None
    if (dest / 'error.json').is_file():
        error = json.loads((dest / 'error.json').read_text())
    if code == 3:
        lines += [f'{head}: COMPILE FAILED'] + pipeline.compile_errors(dest / 'compile.log')
    elif error is not None:
        lines.append(f'{head}: REFUSED {error["status"]}')
        lines.append(f'    {error["detail"][:300]}')
    else:
        objdump = disasm.find_objdump(config.get('objdump'))
        rows, outcome = [], []
        for fn in task['functions']:
            fdir = dest / f'0x{fn["rva"]:x}'
            line, result = pipeline.function_line(fn, fdir, dest / 'candidate.obj')
            rows.append('  ' + line)
            outcome.append(result)
            if result == 'fail':  # aligned diagnostics (align.py): distance and classes under the function's line
                rows[-1] += ''.join(f'\n      {s}' for s in align.attempt_summary(
                    fdir, objdump, config.get('image'), dest / 'candidate.obj', fn, task['symbols_local']))
            sbs, why = disasm.write_side_by_side(fdir / 'side-by-side.txt', objdump, config.get('image'),
                                                 dest / 'candidate.obj', fn['symbol'], fn['rva'], fn['size'])
            if sbs is None and why and not any('side-by-side' in r for r in rows):
                rows.append(f'  (no side-by-side: {why})')
        passed = sum(r == 'pass' for r in outcome)
        lines.append(f'{head}: {passed}/{len(outcome)} pass; includes = closure ({len(closure)} repo files)')
        all_rows = rows
        lines += rows[:10]
        if len(rows) > 10:
            lines.append(f'  ... {len(rows) - 10} more lines in {dest / "attempt.txt"}')
    lines += bind_lines
    lines += label_warnings(closure)
    lines += origin_lines(closure)
    rel = dest.relative_to(Path.cwd()) if dest.is_relative_to(Path.cwd()) else dest
    lines.append(f'private: {rel}/ (0x<rva>/side-by-side.txt, compile.log; read locally, never paste)')
    if runner is not None:
        where = f'runner: {runners.describe(runner)}' + (f'; waited {host.waited:.0f} s for a slot'
                                                          if host.waited >= 1 else '')
    lines.append(where)
    lines.append(f'time {time.monotonic() - started:.1f} s')
    text = '\n'.join(lines)
    (dest / 'attempt.txt').write_text(text + '\n' + ''.join(f'{r}\n' for r in all_rows))
    with open(task_dir / 'attempts.jsonl', 'a') as log:
        log.write(json.dumps({'attempt': number, 'exit': code, 'counted': counted,
                              **({'free_compile_failure': True} if free_compile else {}),
                              'seconds': round(time.monotonic() - started, 1),
                              'runner': runner['host_id'] if runner else 'boat',
                              'source_revision': _revision(dest)}) + '\n')
    print(text)
    if runner is None:
        # The standing machine is billed while the attempt runs, so wall time is the draft's compute.
        wall = time.monotonic() - started
        pipeline.record_cost(task, 'draft', wall, wall)
    return {0: 0, 1: 1, 3: 3, 4: 4}.get(code, 2)


def group_status(group_dir):
    """Lines describing a multi-unit task directory (group.json): each unit's counted attempts and
    last result. A group is never compiled as a whole; each unit is attempted on its own."""
    group = json.loads((group_dir / 'group.json').read_text())
    lines = [f'group {group["group_id"]}: {len(group["units"])} units, {group["functions"]} functions; '
             f'attempt each unit: tools/verifier/attempt <this dir>/<unit dir>']
    for u in group['units']:
        udir = group_dir / u['dir']
        used = counted_attempts(udir / 'attempts.jsonl')
        last = 'not attempted'
        runs = sorted(p for p in (udir / 'attempts').glob('[0-9][0-9][0-9]') if p.is_dir()) \
            if (udir / 'attempts').is_dir() else []
        if runs and (runs[-1] / 'attempt.txt').is_file():
            head = (runs[-1] / 'attempt.txt').read_text().splitlines()[:1]
            last = head[0].split(': ', 1)[-1] if head else 'no summary'
        lines.append(f'  {u["dir"]}: {u["compiled"]}; {len(u["functions"])} functions; counted {used}/'
                     f'{u["max_attempts"]}; last: {last}')
    return lines


def label_warnings(closure):
    """tools/check_labels.py findings for the unit's sources, printed as warnings after the results.

    They never change the exit status: the label check reads private community checkouts that are
    not always present, and its findings are for the Drafter and Reviewer to judge.
    """
    try:
        sys.path.insert(0, str(pipeline.REPO / 'tools'))
        import check_labels
        findings = check_labels.check([pipeline.REPO / name for name in closure])
    except Exception as exc:  # noqa: BLE001 - a broken optional check must not hide the comparison
        return [f'  label check: not run ({type(exc).__name__}: {exc})']
    if not findings:
        return ['  label check: no findings']
    return [f'  label warning: {f}' for f in findings]


def origin_lines(closure):
    """tools/check_origin.py hits for the unit's sources: bodies close to a same-named community or
    FNV body. Advisory like the label check; an adapted body must be declared in the unit header
    (docs/drafter-card.md), which the Reviewer checks starting from this list."""
    try:
        sys.path.insert(0, str(pipeline.REPO / 'tools'))
        import check_origin
        clones, _missing = check_origin.open_clones(pipeline.REPO)
        hits = check_origin.check_unit([pipeline.REPO / name for name in closure], clones, root=pipeline.REPO)
    except Exception as exc:  # noqa: BLE001 - a broken optional check must not hide the comparison
        return [f'  origin check: not run ({type(exc).__name__}: {exc})']
    if not hits:
        return ['  origin check: no body at or above the similarity threshold']
    out = [f'  origin: {check_origin.describe(h)}' for h in hits]
    if any(not h['trivial'] and not h['fork_of'] and not h['declared'] for h in hits):
        out.append('  origin advice: name each adapted body, its upstream file, revision and licence in the '
                   'unit header (FNV: a Sibling source line); docs/drafter-card.md')
    return out


def _revision(dest):
    try:
        return json.loads((dest / 'result.json').read_text())['source_revision']
    except (OSError, ValueError, KeyError):
        return None


def clean(task_dir):
    """Remove this task's directory on the standing machine if it is running; never starts or stops it."""
    task = pipeline.load_task(task_dir)
    handle = pipeline.lock(task['dir'])  # noqa: F841 (held until exit)
    if runners.for_attempt() is not None:
        # Runner hosts get a fresh copy per run and remove it afterwards; nothing is left to remove.
        (task['dir'] / '.attempt' / 'sync.json').unlink(missing_ok=True)
        print('attempt runs on a runner host (.local/verifier/runners.json), which keeps no task files; nothing removed')
        return 0
    machine, state = boatctl.lookup()
    remote = f'{boatctl.REMOTE_HOME}/tasks/{task["task_id"]}'
    if machine is not None and state in boatctl.RUNNING:
        boatctl.execute(machine, f'rm -rf {shlex.quote(remote)}', 60)
        print(f'removed {remote} on {boatctl.STANDING}')
    else:
        print(f'{boatctl.STANDING} is {state}; nothing removed remotely (the next attempt uploads afresh)')
    (task['dir'] / '.attempt' / 'sync.json').unlink(missing_ok=True)
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('task_dir', nargs='?')
    p.add_argument('--clean', action='store_true', help="remove the task's files on the machine")
    p.add_argument('--stop', action='store_true', help=argparse.SUPPRESS)
    p.add_argument('--force', action='store_true', help=argparse.SUPPRESS)
    a = p.parse_args()
    try:
        if a.stop:
            print('attempt --stop is retired: attempt never stops a machine. Engineers end a session with '
                  'tools/verifier/session down; per-task cleanup is attempt --clean <task-dir>.', file=sys.stderr)
            return 2
        if a.clean:
            if not a.task_dir:
                p.error('--clean needs a task directory')
            return clean(a.task_dir)
        if not a.task_dir:
            p.error('a task directory is required')
        group_dir = pipeline.resolve_task_dir(a.task_dir)
        if not (group_dir / 'task.json').is_file() and (group_dir / 'group.json').is_file():
            print('\n'.join(group_status(group_dir)))
            return 2
        return attempt(a.task_dir)
    except (PipelineError, boatctl.BoatError, runners.RunnerError) as exc:
        print(f'attempt: {exc}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
